# ==================================
# SmartWord Server Configuration
# ==================================
# SECURITY: Generate secure values for all secrets!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# USAGE:
# - Development: Copy to .env.development
# - Production: Copy to .env

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/smartword

# --- JWT Secrets (ОБЯЗАТЕЛЬНО сгенерируйте новые!) ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ В production: минимум 32 символа, уникальные значения
# ⚠️ В development: минимум 8 символов (но лучше использовать полноценные)
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- OpenRouter API Keys (comma-separated) ---
# Каждый ключ с $10+ даёт 1,000 бесплатных запросов/день
# Get keys: https://openrouter.ai/keys
OPENROUTER_API_KEYS=

# --- App Public URL ---
# For email links (verification, password reset)
# Development: http://localhost:3000
# Production: https://api.smartword.app
APP_PUBLIC_URL=http://localhost:3000

# --- SMTP Configuration (for sending emails) ---
# Development: можно использовать Mailtrap или Ethereal
# Production: обязательно настройте реальный SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@smartword.app

# --- Google OAuth (for Google Sign-In) ---
GOOGLE_CLIENT_ID=

# --- YooKassa (payment processing) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000

# --- Telegram Support Bot ---
# Create bot: @BotFather → /newbot
# Get Chat ID: @userinfobot → /start
# ⚠️ FROZEN: Set TELEGRAM_BOT_ENABLED=true to enable
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- CORS Allowed Origins (comma-separated) ---
# Development: http://localhost:19006,http://localhost:8081,exp://...
# Production: ТОЛЬКО ваши домены (никаких localhost!)
# Example production: https://smartword.app,https://www.smartword.app
ALLOWED_ORIGINS=
