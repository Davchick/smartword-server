server {
    listen 443 ssl;
    server_name smart-word.ru www.smart-word.ru;
    ssl_certificate /etc/letsencrypt/live/smart-word.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/smart-word.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;

    root /var/www/website;
    index index.html;

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Кэширование Next.js статики (хэши в именах — можно кэшировать надолго)
    location /_next/static {
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    # Кэширование картинок и иконок
    location ~* \.(jpg|jpeg|png|gif|svg|ico|webp)$ {
        expires 30d;
        add_header Cache-Control "public";
    }
}

# HTTP → HTTPS редирект
server {
    listen 80;
    server_name smart-word.ru www.smart-word.ru;
    return 301 https://$server_name$request_uri;
}
